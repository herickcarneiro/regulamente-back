# development/test → cookie sem Secure (HTTP local / Compose)
# production → cookie com Secure (HTTPS)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://regulamente:regulamente@127.0.0.1:5432/regulamente
CORS_ORIGINS=http://localhost:5173,http://localhost:5176
SESSION_TTL_SECONDS=28800

# Seed CLI (required for `bun run identity:seed`) — never commit real secrets
IDENTITY_SEED_ADMIN_EMAIL=admin@regulamente.local
IDENTITY_SEED_ADMIN_PASSWORD=
IDENTITY_SEED_ADMIN_NAME=Admin

# Planned (not used by Identity v1)
# REDIS_URL=redis://localhost:6379

# Cloudflare Stream (Media video upload + ADM playback)
# Without account/token: API boots; POST video-upload-requests → 500 internal
# Without CLOUDFLARE_STREAM_CUSTOMER_CODE: upload may work; playback → 500 internal
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_STREAM_API_BASE=https://api.cloudflare.com/client/v4
CLOUDFLARE_STREAM_TIMEOUT_MS=10000
CLOUDFLARE_STREAM_CUSTOMER_CODE=
# Optional CSV of embed origins for direct upload — hostnames only (no scheme)
# CLOUDFLARE_STREAM_ALLOWED_ORIGINS=localhost:5173,localhost:5176,app.example.com
# v1 explicit limits (no silent 3600)
MEDIA_MAX_DURATION_SECONDS=900
MEDIA_UPLOAD_URL_TTL_SECONDS=900
MEDIA_PLAYBACK_TOKEN_TTL_SECONDS=900

# HTTP access log (one line per response). Defaults: on in development, off in test.
# HTTP_LOG_ENABLED=true
# HTTP_LOG_COLOR=true

# Cloudflare R2 foundation (private buckets per env) — not used by Media video runtime v1
# See docs/media-r2-foundation.md — do not commit real secrets
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
