{
  "name": "regulamente-back",
  "version": "1.0.50",
  "private": true,
  "type": "module",
  "module": "src/main/server.ts",
  "scripts": {
    "dev": "bun run --watch src/main/server.ts",
    "start": "bun run src/main/server.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "node ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "bun run src/main/persistence/migrate.ts",
    "db:check": "node ./node_modules/drizzle-kit/bin.cjs check",
    "db:studio": "node ./node_modules/drizzle-kit/bin.cjs studio",
    "identity:seed": "bun run src/modules/identity/infrastructure/cli/seed-identity.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "elysia": "^1.4.29",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "bun-types": "^1.3.14",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
